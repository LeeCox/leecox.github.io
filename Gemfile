source "https://rubygems.org"

# Mirrors the GitHub Pages build environment for local preview.
gem "github-pages", group: :jekyll_plugins
gem "webrick"

# Ruby 3.4+ stdlib extractions Jekyll 3.9 still requires (local build only;
# the GitHub Pages builder uses its own gem set and ignores these).
